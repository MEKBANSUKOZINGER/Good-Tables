{
  "name": "good-tables",
  "version": "0.1.3",
  "private": true,
  "license": "MIT",
  "description": "Add formatting, diagonal cells and non-destructive merges to native Obsidian Markdown tables.",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "test": "node scripts/test.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "format": "prettier --write src tests scripts *.json *.mjs *.css *.md",
    "format:check": "prettier --check src tests scripts *.json *.mjs *.css *.md"
  },
  "devDependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.5",
    "happy-dom": "^20.0.0",
    "obsidian": "latest",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  }
}
