{
  "name": "good-tables",
  "version": "0.2.4",
  "private": true,
  "license": "MIT",
  "description": "Add formatting, diagonal cells and non-destructive merges to native Obsidian Markdown tables.",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "test": "node scripts/test.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "format": "prettier --write src tests scripts *.json *.mjs *.css *.md",
    "format:check": "prettier --check src tests scripts *.json *.mjs *.css *.md",
    "lint": "eslint src --max-warnings 0"
  },
  "devDependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.5",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "happy-dom": "^21.0.4",
    "obsidian": "latest",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "eslint-plugin-obsidianmd": {
      "moment": "^2.31.0"
    }
  }
}
